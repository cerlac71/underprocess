# SIH26071 Alert Notification Configuration
# Copy to .env and fill in your values, then: export $(cat .env | xargs)

# Region (uttar_pradesh | belagavi | india)
SIH_REGION=uttar_pradesh

# Email alerts (SMTP)
SIH_SMTP_HOST=smtp.gmail.com
SIH_SMTP_PORT=587
SIH_SMTP_USER=your-email@gmail.com
SIH_SMTP_PASSWORD=your-app-password
SIH_SMTP_FROM=your-email@gmail.com
SIH_ALERT_EMAIL=your-email@gmail.com

# SMS alerts (Twilio)
SIH_TWILIO_ACCOUNT_SID=
SIH_TWILIO_AUTH_TOKEN=
SIH_TWILIO_FROM_NUMBER=+1234567890
SIH_ALERT_PHONE=+919876543210

# Webhook (Slack, Discord, custom API)
SIH_ALERT_WEBHOOK_URL=

# Desktop notifications (macOS/Linux) — set 0 to disable
SIH_DESKTOP_ALERTS=1

# IMD Doppler radar sample for nowcast demo
SIH_USE_IMD_RADAR_SAMPLE=1
